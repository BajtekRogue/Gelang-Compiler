# Store const = 1 at p[501]
SET 1
STORE 501
# x := 0
SUB 0
STORE 1001
# y := 10
SET 10
STORE 1002
# REPEAT _1_: 
# x := x + 1
LOAD 501
STORE 1
LOAD 1001
ADD 1
STORE 1001
# y := y - 1
LOAD 501
STORE 1
LOAD 1002
SUB 1
STORE 1002
# WRITE x
PUT 1001
# WRITE y
PUT 1002
LOAD 1002
STORE 1
LOAD 1001
SUB 1
JNEG -16
JZERO -17
# UNTIL _1_: x > y
# WRITE x
PUT 1001
# WRITE y
PUT 1002
HALT
