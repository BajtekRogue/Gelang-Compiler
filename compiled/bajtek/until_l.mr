# WRITE x
PUT 1001
# WRITE y
PUT 1002
LOAD 1002
STORE 1
LOAD 1001
SUB 1
JZERO -16
# UNTIL _1_: x != y
# WRITE x
PUT 1001
# WRITE y
PUT 1002
HALT
