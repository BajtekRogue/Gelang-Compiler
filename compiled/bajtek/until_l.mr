# x := 0
SUB 0
STORE 1001
# y := 10
SET 10
STORE 1002
# REPEAT _1_: 
# x := x + 1
SET 1
STORE 1
LOAD 1001
ADD 1
STORE 1001
# y := y - 1
SET 1
STORE 1
LOAD 1002
SUB 1
