PROGRAM IS
    i, j, n, tmp, a[1:10], x , y
BEGIN
    # Fill array with random numbers
    a[1] := 5;
    a[2] := 3;
    a[3] := -8;
    a[4] := 1;
    a[5] := -2;
    a[6] := -9;
    a[7] := 4;
    a[8] := 7;
    a[9] := 6;
    a[10] := -10;

    n := 10;
    i := 1;
    WHILE i <= n DO
        j := 1;
        x := n - i;
        WHILE j <= x DO
            y := j + 1;
            IF a[j] > a[y] THEN
                tmp := a[y];
                a[y] := a[j];
                a[j] := tmp;
            ENDIF
            j := j + 1;
        ENDWHILE
        i := i + 1;
    ENDWHILE

    #print the array
    i := 1;
    WHILE i <= n DO
        WRITE a[i];
        i := i + 1;
    ENDWHILE
END