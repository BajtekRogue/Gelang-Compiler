# zagnieżdżone pętle 
#	0 0 0
#	31000 40900 2222010
#	
#	1 0 2
#	31001 40900 2222012

PROGRAM IS
	a, b, c, i, j, k, const[1:7]
BEGIN
	READ a;
	READ b;
	READ c;
    const[1] := 111091;
    const[2] := 111110;
    const[3] := 209;
    const[4] := 200;
    const[5] := 11;
    const[6] := 20;
    const[7] := 1;

	i:=const[1];
	WHILE i<=const[2] DO
		j:=const[3];
		WHILE j>=const[4] DO
			k:=const[5];
			WHILE k<=const[6] DO
				a:=a+k;
				k:=k+const[7];
			ENDWHILE
			b:=b+j;
			j:=j-const[7];
		ENDWHILE
		c:=c+i;
                i:=i+const[7];
	ENDWHILE
	WRITE a;
	WRITE b;
	WRITE c;
END
